[Unit]
Description=Soul Room Edge Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/edge-agent -config /etc/edge-agent/config.yaml
Restart=always
RestartSec=5s
StateDirectory=edge-agent
RuntimeDirectory=edge-agent
ConfigurationDirectory=edge-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
