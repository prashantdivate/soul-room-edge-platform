# Company identity and first organization owner. These values are read only
# when a clean installation is initialized.
SOULROOM_ORGANIZATION_NAME=Acme Devices
SOULROOM_ORGANIZATION_SLUG=acme-devices
SOULROOM_ADMIN_EMAIL=admin@acme.com
SOULROOM_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional organization defaults. Owners can change safe operational values
# later under Settings > Platform settings without restarting services.
SOULROOM_COMPANY_DOMAIN=devices.example.com
SOULROOM_DEVICE_OFFLINE_MINUTES=5
SOULROOM_DEFAULT_TELEMETRY_WINDOW=1h
SOULROOM_DEFAULT_OTA_PILOT_PERCENT=10
SOULROOM_DEFAULT_ENROLLMENT_TTL_HOURS=24
SOULROOM_DEFAULT_JOB_TTL_MINUTES=60

# IP address or DNS name used by physical devices to reach this computer.
SOULROOM_DEVICE_PUBLIC_HOST=localhost

# Bundled ShellHub endpoints. Replace localhost with the LAN IP or DNS name
# that managed devices and operators use to reach this host.
SOULROOM_SHELLHUB_DOMAIN=localhost
SOULROOM_SHELLHUB_URL=http://localhost:8088
SOULROOM_SHELLHUB_HTTP_PORT=8088
SOULROOM_SHELLHUB_SSH_PORT=22222
SOULROOM_SHELLHUB_POSTGRES_PASSWORD=replace-with-a-long-unique-password
